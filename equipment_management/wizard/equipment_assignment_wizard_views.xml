<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_equipment_assignment_wizard_form" model="ir.ui.view">
        <field name="name">equipment.assignment.wizard.form</field>
        <field name="model">equipment.assignment.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Equipment">
                <group string="Assignment">
                    <group>
                        <field name="equipment_id"/>
                        <field name="employee_id"/>
                    </group>
                    <group>
                        <field name="assigned_at"/>
                        <field name="condition_on_assignment"/>
                    </group>
                </group>
                <group string="Notes">
                    <field name="notes" placeholder="Record accessories, handover details, or other assignment notes..." nolabel="1"/>
                </group>
                <footer>
                    <button name="action_confirm_assignment" string="Confirm Assignment" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
