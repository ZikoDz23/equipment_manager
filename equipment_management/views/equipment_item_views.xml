<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_equipment_item_tree" model="ir.ui.view">
        <field name="name">equipment.item.tree</field>
        <field name="model">equipment.item</field>
        <field name="arch" type="xml">
            <list default_order="name">
                <field name="reference"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="serial_number"/>
                <field name="status" widget="badge" 
                       decoration-success="status == 'available'" 
                       decoration-warning="status == 'assigned'" 
                       decoration-info="status == 'maintenance'" 
                       decoration-danger="status in ('lost', 'retired')"/>
                  <button name="action_assign" string="Assign" type="object" icon="fa-user-plus" invisible="status != 'available'"/>
                  <button name="action_return" string="Return" type="object" icon="fa-undo" invisible="status != 'assigned'"/>
                <field name="employee_id"/>
                <field name="location"/>
                <field name="company_id" optional="show" groups="base.group_multi_company"/>
                <field name="purchase_date" optional="hide"/>
                <field name="warranty_expiration_date" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_equipment_item_form" model="ir.ui.view">
        <field name="name">equipment.item.form</field>
        <field name="model">equipment.item</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_assign" string="Assign" type="object" class="oe_highlight" invisible="status != 'available'"/>
                    <button name="action_return" string="Return" type="object" class="oe_highlight" invisible="status != 'assigned'"/>
                    <button name="action_set_available" string="Set Available" type="object" invisible="status != 'maintenance'"/>
                    <button name="action_set_maintenance" string="Set Maintenance" type="object" invisible="status not in ('available', 'assigned')"/>
                    <button name="action_mark_lost" string="Mark Lost" type="object" invisible="status not in ('available', 'assigned')"/>
                    <button name="action_retire" string="Retire" type="object" invisible="status == 'retired'"/>
                    <field name="status" widget="statusbar" statusbar_visible="available,assigned,maintenance"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_assignments" type="object" class="oe_stat_button" icon="fa-history">
                            <field name="assignment_count" widget="statinfo" string="Assignments"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="reference"/>
                        </h1>
                        <h2>
                            <field name="name" placeholder="Equipment Name..."/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="serial_number"/>
                            <field name="location"/>
                        </group>
                        <group>
                            <field name="employee_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="purchase_date"/>
                            <field name="warranty_expiration_date"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="General Information">
                            <group>
                                <field name="current_assignment_id"/>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_equipment_item_kanban" model="ir.ui.view">
        <field name="name">equipment.item.kanban</field>
        <field name="model">equipment.item</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="name"/>
                <field name="reference"/>
                <field name="category_id"/>
                <field name="serial_number"/>
                <field name="employee_id"/>
                <field name="location"/>
                <field name="status"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><field name="reference"/></div>
                                <div><field name="category_id"/></div>
                                <div t-if="record.serial_number.raw_value">SN: <field name="serial_number"/></div>
                                <div t-if="record.employee_id.raw_value">
                                    <i class="fa fa-user" role="img" aria-label="Employee" title="Employee"></i> <field name="employee_id"/>
                                </div>
                                <div t-if="record.location.raw_value">
                                    <i class="fa fa-map-marker" role="img" aria-label="Location" title="Location"></i> <field name="location"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_equipment_item_search" model="ir.ui.view">
        <field name="name">equipment.item.search</field>
        <field name="model">equipment.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reference"/>
                <field name="serial_number"/>
                <field name="category_id"/>
                <field name="employee_id"/>
                <field name="location"/>
                <field name="status"/>
                <field name="company_id"/>
                <separator/>
                <filter string="Available" name="status_available" domain="[('status', '=', 'available')]"/>
                <filter string="Assigned" name="status_assigned" domain="[('status', '=', 'assigned')]"/>
                <filter string="Under Maintenance" name="status_maintenance" domain="[('status', '=', 'maintenance')]"/>
                <filter string="Lost" name="status_lost" domain="[('status', '=', 'lost')]"/>
                <filter string="Retired" name="status_retired" domain="[('status', '=', 'retired')]"/>
                <filter string="Needs Attention" name="needs_attention" domain="['|', ('status', 'in', ['maintenance', 'lost']), '&amp;', ('warranty_expiration_date', '!=', False), ('warranty_expiration_date', '&lt;=', context_today() + relativedelta(days=30))]"/>
                <filter string="Warranty Expiring in 30 Days" name="warranty_expiring" domain="[('warranty_expiration_date', '&gt;=', context_today()), ('warranty_expiration_date', '&lt;=', context_today() + relativedelta(days=30))]"/>
                <filter string="Warranty Expired" name="warranty_expired" domain="[('warranty_expiration_date', '&lt;', context_today())]"/>
                <separator/>
                <filter string="Assigned to Me" name="assigned_to_me" domain="[('employee_id.user_id', '=', uid)]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                
                <group>
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Current Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                    <filter string="Location" name="group_location" context="{'group_by': 'location'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Dashboard Actions & Views -->
    <record id="view_equipment_item_graph" model="ir.ui.view">
        <field name="name">equipment.item.graph</field>
        <field name="model">equipment.item</field>
        <field name="arch" type="xml">
            <graph string="Equipment Status" type="pie">
                <field name="status"/>
            </graph>
        </field>
    </record>

    <record id="view_equipment_item_pivot" model="ir.ui.view">
        <field name="name">equipment.item.pivot</field>
        <field name="model">equipment.item</field>
        <field name="arch" type="xml">
            <pivot string="Equipment Analysis">
                <field name="category_id" type="row"/>
                <field name="status" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- Dashboard Read-Only Views -->
    <record id="view_equipment_item_kanban_dashboard" model="ir.ui.view">
        <field name="name">equipment.item.kanban.dashboard</field>
        <field name="model">equipment.item</field>
        <field name="inherit_id" ref="view_equipment_item_kanban"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="create">false</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_equipment_item_tree_dashboard" model="ir.ui.view">
        <field name="name">equipment.item.tree.dashboard</field>
        <field name="model">equipment.item</field>
        <field name="inherit_id" ref="view_equipment_item_tree"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="create">false</attribute>
            </xpath>
        </field>
    </record>

    <record id="action_equipment_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">equipment.item</field>
        <field name="view_mode">kanban,graph,pivot,list,form</field>
        <field name="context">{'search_default_group_status': 1}</field>
    </record>

    <record id="action_equipment_dashboard_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_equipment_item_kanban_dashboard"/>
        <field name="act_window_id" ref="action_equipment_dashboard"/>
    </record>

    <record id="action_equipment_dashboard_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_equipment_item_tree_dashboard"/>
        <field name="act_window_id" ref="action_equipment_dashboard"/>
    </record>

    <record id="action_equipment_item" model="ir.actions.act_window">
        <field name="name">Equipment</field>
        <field name="res_model">equipment.item</field>
        <field name="view_mode">list,kanban,form</field>
    </record>
</odoo>
