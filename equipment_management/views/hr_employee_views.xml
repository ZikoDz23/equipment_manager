<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_form_inherit_equipment_management" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.equipment_management</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
             <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_equipment" type="object" string="Equipment" class="oe_stat_button" icon="fa-building-o">
                    <field name="equipment_item_count" widget="statinfo" string="Currently Assigned"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>

        

    