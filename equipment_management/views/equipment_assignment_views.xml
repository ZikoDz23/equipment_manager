<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_equipment_assignment_tree" model="ir.ui.view">
        <field name="name">equipment.assignment.tree</field>
        <field name="model">equipment.assignment</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="equipment_id"/>
                <field name="employee_id"/>
                <field name="assigned_at"/>
                <field name="returned_at"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-info="state == 'returned'"/>
                <field name="assigned_by"/>
                <field name="returned_by"/>
                <field name="return_status"/>
            </list>
        </field>
    </record>

    <record id="view_equipment_assignment_form" model="ir.ui.view">
        <field name="name">equipment.assignment.form</field>
        <field name="model">equipment.assignment</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="equipment_id"/>
                            <field name="employee_id"/>
                            <field name="condition_on_assignment"/>
                            <field name="condition_on_return" invisible="state == 'active'"/>
                            <field name="return_status" invisible="state == 'active'"/>
                        </group>
                        <group>
                            <field name="assigned_at"/>
                            <field name="returned_at" invisible="state == 'active'"/>
                            <field name="assigned_by"/>
                            <field name="returned_by" invisible="state == 'active'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_equipment_assignment_search" model="ir.ui.view">
        <field name="name">equipment.assignment.search</field>
        <field name="model">equipment.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="equipment_id"/>
                <field name="employee_id"/>
                <field name="assigned_by"/>
                <separator/>
                <filter string="Active Assignments" name="active_assignments" domain="[('state', '=', 'active')]"/>
                <filter string="Returned Assignments" name="returned_assignments" domain="[('state', '=', 'returned')]"/>
                <separator/>
                <filter string="Assigned Today" name="assigned_today" domain="[('assigned_at', '&gt;=', datetime.datetime.now().strftime('%Y-%m-%d 00:00:00')), ('assigned_at', '&lt;=', datetime.datetime.now().strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter string="Assigned This Month" name="assigned_month" domain="[('assigned_at', '&gt;=', (datetime.datetime.now().replace(day=1)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter string="Returned This Month" name="returned_month" domain="[('returned_at', '&gt;=', (datetime.datetime.now().replace(day=1)).strftime('%Y-%m-%d 00:00:00'))]"/>
                
                <group>
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Equipment" name="group_equipment" context="{'group_by': 'equipment_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Assigned By" name="group_assigned_by" context="{'group_by': 'assigned_by'}"/>
                    <filter string="Assignment Month" name="group_assigned_month" context="{'group_by': 'assigned_at:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_equipment_assignment" model="ir.actions.act_window">
        <field name="name">Assignments</field>
        <field name="res_model">equipment.assignment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
