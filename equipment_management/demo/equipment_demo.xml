<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Categories -->
        <record id="cat_laptop" model="equipment.category">
            <field name="name">Laptop</field>
            <field name="code">LAP</field>
        </record>
        <record id="cat_mobile" model="equipment.category">
            <field name="name">Mobile Phone</field>
            <field name="code">MOB</field>
        </record>
        <record id="cat_monitor" model="equipment.category">
            <field name="name">Monitor</field>
            <field name="code">MON</field>
        </record>
        <record id="cat_tool" model="equipment.category">
            <field name="name">Tool</field>
            <field name="code">TOOL</field>
        </record>
        <record id="cat_accessory" model="equipment.category">
            <field name="name">Accessory</field>
            <field name="code">ACC</field>
        </record>

        <!-- Employees (assume base employees exist or we create minimal ones, but 'hr' is depended upon. standard odoo demo data has employees.) -->
        <record id="demo_employee_1" model="hr.employee">
            <field name="name">Alice Smith</field>
        </record>
        <record id="demo_employee_2" model="hr.employee">
            <field name="name">Bob Jones</field>
        </record>

        <!-- Equipment -->
        <record id="eq_1" model="equipment.item">
            <field name="name">MacBook Pro 16"</field>
            <field name="category_id" ref="cat_laptop"/>
            <field name="serial_number">MBP-12345</field>
            <field name="status">available</field>
        </record>
        <record id="eq_2" model="equipment.item">
            <field name="name">Dell XPS 15</field>
            <field name="category_id" ref="cat_laptop"/>
            <field name="serial_number">DXPS-67890</field>
            <field name="status">available</field>
        </record>
        <record id="eq_3" model="equipment.item">
            <field name="name">iPhone 13</field>
            <field name="category_id" ref="cat_mobile"/>
            <field name="serial_number">IPH-11111</field>
            <field name="status">available</field>
        </record>
        <record id="eq_4" model="equipment.item">
            <field name="name">Dell 27" Monitor</field>
            <field name="category_id" ref="cat_monitor"/>
            <field name="serial_number">DM-22222</field>
            <field name="status">maintenance</field>
        </record>
        <record id="eq_5" model="equipment.item">
            <field name="name">Power Drill</field>
            <field name="category_id" ref="cat_tool"/>
            <field name="serial_number">PD-33333</field>
            <field name="status">available</field>
        </record>

        <!-- Generate Assignment History (Return Eq 1) -->
        <record id="assignment_1" model="equipment.assignment">
            <field name="equipment_id" ref="eq_1"/>
            <field name="employee_id" ref="demo_employee_1"/>
            <field name="assigned_at" eval="(DateTime.today() - relativedelta(months=2)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="returned_at" eval="(DateTime.today() - relativedelta(days=5)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="returned_by" ref="base.user_admin"/>
            <field name="condition_on_assignment">new</field>
            <field name="condition_on_return">good</field>
            <field name="return_status">available</field>
        </record>

        <!-- Active Assignment (Assign Eq 2) -->
        <record id="assignment_2" model="equipment.assignment">
            <field name="equipment_id" ref="eq_2"/>
            <field name="employee_id" ref="demo_employee_2"/>
            <field name="assigned_at" eval="(DateTime.today() - relativedelta(days=10)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="condition_on_assignment">good</field>
        </record>

        <!-- Update Eq 2 to be assigned -->
        <record id="eq_2" model="equipment.item">
            <field name="status">assigned</field>
            <field name="employee_id" ref="demo_employee_2"/>
            <field name="current_assignment_id" ref="assignment_2"/>
        </record>
    </data>
</odoo>
